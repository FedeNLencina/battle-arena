{
  // Solo revisa tipos (`pnpm typecheck`): Vite compila el juego y Node corre las pruebas
  // quitando los tipos, por eso se usa solo sintaxis que se puede borrar sin más.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "e2e", "scripts", "vite.config.ts", "playwright.config.ts"]
}
