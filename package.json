{
  "name": "battle-arena",
  "private": true,
  "version": "1.0.0",
  "description": "Arena de Batalla: juego de combates por turnos con criaturas, mapa, niveles y evoluciones.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:claude": "vite build --base ./ --outDir dist-claude",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "e2e": "node scripts/ensure-browser.ts && playwright test",
    "e2e:ui": "node scripts/ensure-browser.ts && playwright test --ui",
    "typecheck": "tsc",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.15.0"
}
